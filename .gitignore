# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build output (PyInstaller work/dist, wheels, manifests)
# Anchored to the repository root: a bare "build/" or "dist/" also matches the
# *source* directories scripts/build/ and scripts/diagnostics/, silently keeping
# the entire build pipeline out of git.  Only the root output dirs are ignored.
/build/
/dist/
/dist_wheel/

# One-click Windows build caches (big wheels; never ship or commit)
.pip-cache/
wheelhouse/

# Generated build stamp
app/_build.py
installer/version_info.txt

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
